<UserControl x:Class="DepalAdmin.Feature.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Chat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ChatViewModel}"
             d:DesignWidth="1100" d:DesignHeight="650">
    <Grid MaxWidth="980" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 대화 -->
        <HeaderedContentControl Style="{StaticResource Section}" Padding="0">
            <HeaderedContentControl.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="지난 대화 불러오기" Command="{Binding LoadHistoryCommand}"
                            Style="{StaticResource Cmd}" MinHeight="24" Padding="10,1" Margin="0"/>
                    <TextBlock Text="채팅 (같은 서버에 붙은 관리자 프로그램끼리)" VerticalAlignment="Center"/>
                </DockPanel>
            </HeaderedContentControl.Header>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Field}">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="12,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 말풍선 대신 기록장처럼: 왼쪽 세로줄 + 이름·시각 + 내용. 내 글은 진한 줄. -->
                            <Border x:Name="Row" BorderThickness="3,0,0,0" BorderBrush="{StaticResource Brush.RuleSoft}"
                                    Padding="10,4" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Time, Mode=OneWay}" FontFamily="{StaticResource Font.Readout}"
                                             Foreground="{StaticResource Brush.SubText}" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <!-- 붙여 보낸 알람·건전지 -->
                                    <Border Margin="0,5,0,0" Padding="7,3" BorderThickness="1" HorizontalAlignment="Left"
                                            BorderBrush="{StaticResource Brush.Rule}" Background="{StaticResource Brush.Panel}"
                                            Visibility="{Binding RefText, Converter={StaticResource TextToVis}}">
                                        <TextBlock Text="{Binding RefText}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </HeaderedContentControl>

        <!-- 쓰기 -->
        <Border Grid.Row="1" Style="{StaticResource Box}" Margin="0,10,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="붙여 보내기" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}"
                              DisplayMemberPath="Text"/>
                </DockPanel>
                <Button DockPanel.Dock="Right" Content="보내기" Command="{Binding SendCommand}" Style="{StaticResource CmdMain}"
                        IsDefault="True" Margin="8,0,0,0" MinHeight="34"/>
                <StackPanel>
                    <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Height="34" MaxLength="500"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Visibility="{Binding Status, Converter={StaticResource TextToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
