<UserControl x:Class="DepalAdmin.Feature.Auth.Audit.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Auth.Audit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:AuditViewModel}"
             d:DesignWidth="1100" d:DesignHeight="650">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Box}" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="CSV로 저장" Command="{Binding ExportCommand}" Style="{StaticResource Cmd}" Margin="0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="기간" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding From}" Width="125"/>
                    <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0"/>
                    <DatePicker SelectedDate="{Binding To}" Width="125" Margin="0,0,8,0"/>
                    <Button Content="불러오기" Command="{Binding LoadCommand}" Style="{StaticResource CmdMain}"/>
                    <TextBlock Text="종류" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="130"/>
                    <TextBlock Text="사람" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                <DataGridTextColumn Header="아이디" Binding="{Binding UserId}" Width="100"/>
                <DataGridTextColumn Header="이름" Binding="{Binding UserName}" Width="110"/>
                <DataGridTextColumn Header="종류" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
