<UserControl x:Class="DepalAdmin.Feature.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
             d:DesignWidth="1100" d:DesignHeight="650">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="900" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <HeaderedContentControl Header="연결 (다시 시작해야 적용)" Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="서버 데이터" Style="{StaticResource RowName}"/>
                        <CheckBox Content="가짜 데이터 쓰기 (브로커 없이)" IsChecked="{Binding UseFakeMqtt}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="브로커 주소" Style="{StaticResource RowName}"/>
                        <TextBox Text="{Binding BrokerHost, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="브로커 포트" Style="{StaticResource RowName}"/>
                        <TextBox Text="{Binding BrokerPort, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" Height="26"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="이력 데이터" Style="{StaticResource RowName}"/>
                        <CheckBox Content="가짜 데이터 쓰기 (MySQL 없이)" IsChecked="{Binding UseFakeDb}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="MySQL 접속 문자열" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding MySqlConnection, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,4,0,0"
                             FontFamily="Consolas"/>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Column="2" Header="화면 (바로 적용)" Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="라인 이름" Style="{StaticResource RowName}"/>
                        <TextBox Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="자동 로그아웃 (분)" Style="{StaticResource RowName}"/>
                        <TextBox Text="{Binding AutoLogoutMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Height="26"/>
                        <TextBlock Text="0이면 끔" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="고장 알람 소리" Style="{StaticResource RowName}"/>
                        <CheckBox Content="켜기" IsChecked="{Binding AlarmSound}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Text="목록 보관 줄 수" Style="{StaticResource RowName}"/>
                        <TextBox Text="{Binding MaxRows, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Height="26"/>
                    </DockPanel>
                </StackPanel>
            </HeaderedContentControl>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource CmdMain}"/>
                <Button Content="되돌리기" Command="{Binding RevertCommand}" Style="{StaticResource Cmd}"/>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Alarm}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <HeaderedContentControl Grid.Row="2" Grid.ColumnSpan="3" Header="프로그램 정보" Style="{StaticResource Section}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock>
                        <Run Text="버전" Foreground="{StaticResource Brush.SubText}"/>
                        <Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource Font.Readout}"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="계정·작업 기록 폴더" Foreground="{StaticResource Brush.SubText}"/>
                        <Run Text="{Binding DataFolder, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
    </ScrollViewer>
</UserControl>
