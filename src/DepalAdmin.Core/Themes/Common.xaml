<!--
  관리자 화면 공통 모양 — ISA-101 "고성능 HMI" 방식을 따른다.
    1) 바탕은 회색. 정상은 색을 쓰지 않는다.
    2) 색은 이상일 때만: 주의 = 호박색, 고장 = 빨강. (초록·파랑 장식 금지)
    3) 묶음은 둥근 카드가 아니라 제목 줄이 붙은 사각 상자(Section).
    4) 숫자 표시는 Bahnschrift(도로·산업 표지판 글꼴, 윈도우 기본 내장).
  페이지에서는 색·글꼴을 직접 쓰지 말고 아래 키를 쓴다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DepalAdmin.Core.Converters">

    <!-- ── 바탕·선 ── -->
    <SolidColorBrush x:Key="Brush.Screen" Color="#CFCEC8"/>     <!-- 화면 바탕 -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#E6E5E0"/>      <!-- 상자 안 -->
    <SolidColorBrush x:Key="Brush.PanelHead" Color="#D6D5CF"/>  <!-- 상자 제목 줄, 표 머리 -->
    <SolidColorBrush x:Key="Brush.Field" Color="#F4F3EF"/>      <!-- 입력칸, 버튼 -->
    <SolidColorBrush x:Key="Brush.Rule" Color="#8F8E87"/>       <!-- 테두리 -->
    <SolidColorBrush x:Key="Brush.RuleSoft" Color="#BDBCB5"/>   <!-- 표 줄 -->
    <SolidColorBrush x:Key="Brush.Frame" Color="#30343A"/>      <!-- 위 머리줄, 현재 공정 -->
    <SolidColorBrush x:Key="Brush.FrameText" Color="#ECEBE6"/>
    <SolidColorBrush x:Key="Brush.FrameSub" Color="#9DA3A9"/>
    <SolidColorBrush x:Key="Brush.Tab" Color="#BDBCB5"/>        <!-- 선택 안 된 탭 -->

    <!-- ── 글자 ── -->
    <SolidColorBrush x:Key="Brush.Text" Color="#1E1E1C"/>
    <SolidColorBrush x:Key="Brush.SubText" Color="#5B5A54"/>

    <!-- ── 상태 (이상일 때만) ── -->
    <SolidColorBrush x:Key="Brush.Ok" Color="#3D6644"/>         <!-- 연결됨 표시 점 정도에만 -->
    <SolidColorBrush x:Key="Brush.Warn" Color="#A57A00"/>
    <SolidColorBrush x:Key="Brush.WarnFill" Color="#F1DE96"/>
    <SolidColorBrush x:Key="Brush.Alarm" Color="#B3241B"/>
    <SolidColorBrush x:Key="Brush.AlarmFill" Color="#EEC1BC"/>
    <SolidColorBrush x:Key="Brush.SafetyYellow" Color="#F2C200"/>

    <!-- ── 등급 (채도 낮춤) ── -->
    <SolidColorBrush x:Key="Brush.GradeA" Color="#3D6644"/>
    <SolidColorBrush x:Key="Brush.GradeB" Color="#3E5C82"/>
    <SolidColorBrush x:Key="Brush.GradeNG" Color="#B3241B"/>
    <SolidColorBrush x:Key="Brush.GradeResort" Color="#6C4E89"/>
    <SolidColorBrush x:Key="Brush.Empty" Color="#C9C8C1"/>      <!-- 빈 칸 -->

    <!-- ── 글꼴 ── -->
    <FontFamily x:Key="Font.Ui">Malgun Gothic</FontFamily>
    <!-- 숫자·영문은 Bahnschrift, 한글은 맑은 고딕으로 자동 대체 -->
    <FontFamily x:Key="Font.Readout">Bahnschrift, Malgun Gothic</FontFamily>

    <!-- ── 변환기 ── -->
    <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    <conv:StatusToFillConverter x:Key="StatusToFill"/>
    <conv:GradeToBrushConverter x:Key="GradeToBrush"/>
    <conv:InverseBoolToVisibilityConverter x:Key="NotVis"/>
    <conv:TextToVisibilityConverter x:Key="TextToVis"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ── 글자 스타일 ── -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.SubText}"/>
    </Style>

    <!-- 큰 숫자 표시 (개수, 상태) -->
    <Style x:Key="Readout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Readout}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <Style x:Key="ReadoutSmall" TargetType="TextBlock" BasedOn="{StaticResource Readout}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.SubText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── 묶음 상자: 제목 줄 + 내용 ──
         사용: <HeaderedContentControl Header="라인 조작" Style="{StaticResource Section}"> ... </HeaderedContentControl> -->
    <Style x:Key="Section" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource Brush.PanelHead}"
                                    BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,0,0,1" Padding="10,5">
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 제목 줄 없는 상자 -->
    <Style x:Key="Box" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- 등급 표시 칸 -->
    <Style x:Key="GradeTag" TargetType="Border">
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="44"/>
    </Style>

    <!-- ── 버튼: 각진 물리 버튼 느낌 ── -->
    <Style x:Key="Cmd" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,2,1,1"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PanelHead}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9A9993"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.RuleSoft}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Panel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 주 동작 (시작 등): 진한 회색 -->
    <Style x:Key="CmdMain" TargetType="Button" BasedOn="{StaticResource Cmd}">
        <Setter Property="Background" Value="{StaticResource Brush.Frame}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
        <Setter Property="BorderBrush" Value="#15171A"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 비상정지: 실제 비상정지 버튼처럼 노란 테두리 + 빨강 -->
    <Style x:Key="EStop" TargetType="Button" BasedOn="{StaticResource Cmd}">
        <Setter Property="Background" Value="{StaticResource Brush.Alarm}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SafetyYellow}"/>
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,4"/>
    </Style>

    <!-- 머리줄 위의 작은 버튼 (로그아웃 등) -->
    <Style x:Key="FrameCmd" TargetType="Button" BasedOn="{StaticResource Cmd}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.FrameSub}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="10,2"/>
    </Style>

    <!-- ── 입력칸 ── -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ── 표: 촘촘하게, 줄무늬 약하게 ── -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.RuleSoft}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
        <Setter Property="RowBackground" Value="{StaticResource Brush.Field}"/>
        <Setter Property="AlternatingRowBackground" Value="#ECEBE6"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="RowHeight" Value="26"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.PanelHead}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Rule}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Frame}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 표 안의 숫자 칸 (오른쪽 정렬, 표지판 글꼴) -->
    <Style x:Key="NumCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Readout}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
</ResourceDictionary>
