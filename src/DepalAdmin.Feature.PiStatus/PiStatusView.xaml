<UserControl x:Class="DepalAdmin.Feature.PiStatus.PiStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.PiStatus"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:PiStatusViewModel}"
             d:DesignWidth="320" d:DesignHeight="360">
    <!-- 바깥 상자(제목 줄)는 장치 상태 화면이 그린다. 여기는 안쪽 내용만. -->
    <StackPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PiState}" FontWeight="SemiBold"
                       Foreground="{Binding PiStateKey, Converter={StaticResource StatusToBrush}}"/>
            <TextBlock Text="하트비트" Style="{StaticResource Label}"/>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 정상이면 회색, 이상일 때만 칠해진다 -->
                    <Border Margin="0,0,0,8" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource Brush.Rule}"
                            Background="{Binding Value, Converter={StaticResource StatusToFill}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource ReadoutSmall}"
                                           FontWeight="SemiBold" Foreground="{Binding Value, Converter={StaticResource StatusToBrush}}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Help}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Visibility="{Binding Help, Converter={StaticResource TextToVis}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
