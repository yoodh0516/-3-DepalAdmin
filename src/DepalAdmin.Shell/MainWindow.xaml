<Window x:Class="DepalAdmin.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DepalAdmin.Shell"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="{Binding StationName, StringFormat='{}{0} 관리 스테이션'}"
        Width="1366" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Ui}" FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        Background="{StaticResource Brush.Screen}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- 머리줄 -->
            <RowDefinition Height="Auto"/> <!-- 탭 -->
            <RowDefinition Height="*"/>    <!-- 페이지 -->
            <RowDefinition Height="36"/>   <!-- 알람 줄 -->
        </Grid.RowDefinitions>

        <!-- ══ 머리줄 ══ -->
        <Border Background="{StaticResource Brush.Frame}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 라인 이름 -->
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StationName}" FontFamily="{StaticResource Font.Readout}" FontSize="21"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.FrameText}"/>
                    <TextBlock Text="건전지 분류 라인" FontSize="11" Foreground="{StaticResource Brush.FrameSub}"/>
                </StackPanel>

                <!-- 라인 상태: 비상정지·일시정지일 때만 칠해진다 -->
                <Border Grid.Column="1" Margin="22,10,0,10" Padding="12,0" MinWidth="140" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.FrameSub}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.FrameText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}" Value="estop">
                                    <Setter Property="Background" Value="{StaticResource Brush.Alarm}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.SafetyYellow}"/>
                                    <Setter Property="TextElement.Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mode}" Value="paused">
                                    <Setter Property="Background" Value="{StaticResource Brush.WarnFill}"/>
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="라인" FontSize="11" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ModeText}" FontFamily="{StaticResource Font.Readout}" FontSize="19" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 연결 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0"
                             Fill="{Binding ConnectionKey, Converter={StaticResource StatusToBrush}}"
                             Stroke="{StaticResource Brush.FrameSub}" StrokeThickness="1"/>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource Brush.FrameText}" FontSize="12"/>
                </StackPanel>

                <!-- 시계 -->
                <TextBlock Grid.Column="4" Text="{Binding Clock}" FontFamily="{StaticResource Font.Readout}" FontSize="15"
                           Foreground="{StaticResource Brush.FrameText}" VerticalAlignment="Center" Margin="0,0,22,0"/>

                <!-- 사용자 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserText}" Foreground="{StaticResource Brush.FrameText}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource Brush.FrameSub}" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding IdleText}" Foreground="{StaticResource Brush.SafetyYellow}" FontSize="11" HorizontalAlignment="Right"
                                   Visibility="{Binding IdleText, Converter={StaticResource TextToVis}}"/>
                    </StackPanel>
                    <Button Content="로그아웃" Command="{Binding LogoutCommand}" Style="{StaticResource FrameCmd}"
                            Visibility="{Binding IsLocked, Converter={StaticResource NotVis}}"/>
                    <Button Content="로그인" Command="{Binding LoginCommand}" Style="{StaticResource FrameCmd}"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- 비상정지: 잠겨 있어도 항상 누를 수 있다 -->
                <Button Grid.Column="6" Content="비상정지" Command="{Binding EstopCommand}" Style="{StaticResource EStop}"
                        Margin="0,7,10,7" MinWidth="110" ToolTip="확인 없이 바로 라인을 멈춥니다"/>
            </Grid>
        </Border>

        <!-- ══ 탭 (F키) ══ -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 Background="{StaticResource Brush.Screen}" BorderThickness="0" Padding="10,8,10,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsLocked, Converter={x:Static local:Not.Instance}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{StaticResource Brush.Tab}" BorderBrush="{StaticResource Brush.Rule}"
                                        BorderThickness="1,1,1,0" Margin="0,0,3,0" Padding="12,6,14,6">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CECDC6"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Panel}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1,3,1,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Key}" FontFamily="{StaticResource Font.Readout}" FontSize="11"
                                   Foreground="{StaticResource Brush.SubText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="13.5"/>
                        <!-- 배지: 안 읽은·확인 안 된 수 (0이면 숨김) -->
                        <Border Background="{StaticResource Brush.Alarm}" Padding="5,0" Margin="7,0,0,0" MinWidth="18"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Badge.BadgeCount, FallbackValue=0}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Badge.BadgeCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="{StaticResource Font.Readout}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ══ 페이지 ══ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,1,0,0" Margin="10,0">
            <Grid Margin="0,10,0,10">
                <ContentControl Content="{Binding SelectedTab.Page.View}" Focusable="False"
                                Visibility="{Binding IsLocked, Converter={StaticResource NotVis}}"/>

                <!-- 잠금 화면 -->
                <Border Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="440"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="1">
                    <StackPanel Margin="26,22">
                        <TextBlock Text="화면이 잠겨 있습니다" FontFamily="{StaticResource Font.Readout}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,16"
                                   Text="로그아웃했거나 한동안 조작이 없어 잠겼습니다. 라인은 계속 돌고 있고, 위쪽 비상정지 버튼은 잠겨 있어도 쓸 수 있습니다."/>
                        <Button Content="로그인" Command="{Binding LoginCommand}" Style="{StaticResource CmdMain}"
                                HorizontalAlignment="Left" MinWidth="120" MinHeight="36"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 알람 줄: 노원종 패널이 들어오는 자리 (PanelSlots.ShellAlarmBar) ══ -->
        <ContentControl Grid.Row="3" Content="{Binding AlarmBar}" Focusable="False"/>
    </Grid>
</Window>
