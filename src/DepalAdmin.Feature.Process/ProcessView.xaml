<UserControl x:Class="DepalAdmin.Feature.Process.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DepalAdmin.Feature.Process"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ProcessViewModel}"
             d:DesignWidth="1200" d:DesignHeight="680">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── 공정 흐름: 지금 공정만 진하게 ── -->
            <HeaderedContentControl Grid.ColumnSpan="5" Style="{StaticResource Section}" Margin="0,0,0,10">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontWeight="Normal" Foreground="{StaticResource Brush.SubText}">
                            <Run Text="회차"/>
                            <Run Text="{Binding RunId, Mode=OneWay}" FontFamily="{StaticResource Font.Readout}"/>
                        </TextBlock>
                        <TextBlock Text="공정 흐름"/>
                    </DockPanel>
                </HeaderedContentControl.Header>

                <ItemsControl ItemsSource="{Binding Stations}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Height="70" BorderThickness="1" Padding="10,8"
                                        Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Rule}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Sub" Text="{Binding Sub}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.SubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 화살표 (마지막 칸은 없음) -->
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 3,0 L 13,8 L 3,16 Z" VerticalAlignment="Center"
                                      HorizontalAlignment="Center" Fill="{StaticResource Brush.Rule}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Frame}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#15171A"/>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Brush.FrameText}"/>
                                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Brush.FrameSub}"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.Frame}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>

            <!-- ── 팔레트 2×5 ── -->
            <HeaderedContentControl Grid.Row="1" Header="팔레트 (이번 회차, 칸 번호 = DB pallet_slot)" Style="{StaticResource Section}">
                <!-- 김하균 패널이 들어오는 자리 (PanelSlots.LinePallet) -->
                <ContentControl Content="{Binding PalletPanel}" Focusable="False"/>
            </HeaderedContentControl>

            <!-- ── 분류 개수 + AGV (김초아) ── -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <HeaderedContentControl Header="분류 개수" Style="{StaticResource Section}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Fill="{StaticResource Brush.GradeA}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="A  → AGV" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CountA}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Rectangle Grid.Row="1" Fill="{StaticResource Brush.GradeB}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="B  → B 분류함" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CountB}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Rectangle Grid.Row="2" Fill="{StaticResource Brush.GradeNG}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="불량  → 불량함" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CountNg}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Rectangle Grid.Row="3" Fill="{StaticResource Brush.GradeResort}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="재분류  → 재분류함" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CountResort}" Style="{StaticResource Readout}" FontSize="22"/>

                        <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="{StaticResource Brush.Rule}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0" Margin="0,4,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Font.Readout}" FontSize="15">
                                    <Run Text="{Binding Total, Mode=OneWay}"/>
                                    <Run Text="개,  A" Foreground="{StaticResource Brush.SubText}"/>
                                    <Run Text="{Binding ARatio, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="합계" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </HeaderedContentControl>

                <!-- AGV: 공정의 마지막 칸 (A 건전지 운송) -->
                <HeaderedContentControl Header="AGV" Style="{StaticResource Section}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvState}" FontWeight="SemiBold"/>
                            <TextBlock Text="위치" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AgvLoad}" Style="{StaticResource ReadoutSmall}"/>
                            <TextBlock Text="A 적재 / 출발 기준" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding AgvFill, Mode=OneWay}" Maximum="100" Height="10" Margin="0,6,0,10"
                                     Foreground="{StaticResource Brush.GradeA}" Background="{StaticResource Brush.Field}"
                                     BorderBrush="{StaticResource Brush.Rule}"/>
                        <TextBlock Text="기록" Style="{StaticResource Label}"/>
                        <ItemsControl ItemsSource="{Binding AgvLog}" Focusable="False" MaxHeight="96" Margin="0,4,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Ts}" Width="88" FontSize="11"
                                                   FontFamily="{StaticResource Font.Readout}" Foreground="{StaticResource Brush.SubText}"/>
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

            </StackPanel>

            <!-- ── 조작 ── -->
            <HeaderedContentControl Grid.Row="1" Grid.Column="4" Header="라인 조작" Style="{StaticResource Section}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="상태" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Readout}" FontSize="22"
                                       Foreground="{Binding Mode, Converter={StaticResource StatusToBrush}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="단계" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Readout}" FontSize="22"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="건전지 번호" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource ReadoutSmall}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 아래 버튼은 유동호 패널이 들어오는 자리 (PanelSlots.LineControls) -->
                    <ContentControl Content="{Binding ControlPanel}" Focusable="False"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ── 서버 메시지 ── -->
            <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource Box}" Margin="0,10,0,0"
                    Visibility="{Binding ServerMessage, Converter={StaticResource TextToVis}}">
                <DockPanel>
                    <TextBlock Text="서버 메시지" Style="{StaticResource Label}" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerMessage}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
